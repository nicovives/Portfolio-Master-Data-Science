    {
        "id": "87eb2a92a09b1888",
        "type": "cheerio-function",
        "z": "e8c2f47500521807",
        "name": "AnálisisLuz",
        "func": "let precio = $('strong:contains(\"Precio medio\")')\n    .parent()\n    .parent()\n    .next()\n    .text();\n\nprecio = precio.substring(0, precio.length - 6);\nprecio = parseFloat(precio);\n\n// Obtener fecha actual\nlet hoy = new Date();\nlet ano = hoy.getFullYear();\nlet mes = hoy.getMonth() + 1; // empieza en 0, por eso sumamos 1\nlet dia = hoy.getDate();\n\n// Construir el payload\nmsg.payload = {\n    precio: precio,\n    dia: dia,\n    mes: mes,\n    ano: ano\n};\n\nreturn msg;\n",
        "outputs": 1,
        "noerr": 1,
        "x": 670,
        "y": 360,
        "wires": [
            [
                "811a5f163ee3e58e",
                "1f436ce7f93f1d7e",
                "5e3226fa70c1948f"
            ]
        ]
    },
    {
        "id": "db4d79dd242a1e77",
        "type": "cheerio-function",
        "z": "e8c2f47500521807",
        "name": "Análisis Temperatura",
        "func": "let filas = $(\"b:contains('Windchill')\")\n    .parent() // Subo al td\n    .parent() // subo al tr\n    .parent() // subo al tbody\n    .children()\n\nlet valores = [];// array de valores vacío\n\nfilas.each(function() {\n    let celdas = $(this).children();\n    let hora = celdas.eq(0).text()\n    if (hora!= \"HeureUTC\"){\n        hora = hora.substring(0, hora.length-3);\n        hora = parseInt(hora);\n        let temp = celdas.eq(4).text();\n        temp = temp.substring(0, temp.length-3);\n        temp = parseFloat(temp);\n        console.log(\"Hora:\", hora, \"Temp:\", temp); // muestra las horas de la tabla en la consola\n        valores.push({\n            anyo: msg.anyo, \n            mes: msg.mes,\n            dia: msg.dia,\n            hora: hora, \n            temp, temp}); // añade valores al array\n    }\n});\n\nmsg.payload=valores\nreturn msg;",
        "outputs": 1,
        "noerr": 3,
        "x": 800,
        "y": 640,
        "wires": [
            [
                "c712ad537269b45b",
                "e17e39a6583dec93",
                "9b0f614a976ece26"
            ]
        ]
    },
