    {
        "id": "04d56d7a2d811842",
        "type": "function",
        "z": "e8c2f47500521807",
        "name": "Generación Consumo",
        "func": "const numHouses = 5; // Simula 5 hogares\nconst messages = [];\nconst now = new Date();\nconst hour = now.getHours();\n// Patrón de consumo simulado por hora\nlet baseConsumption;\nif (hour >= 0 && hour < 7) {\n baseConsumption = Math.random() * 0.6 + 0.2;\n} else if (hour >= 7 && hour < 21) {\n baseConsumption = Math.random() * 0.7 + 0.8;\n} else {\n baseConsumption = Math.random() * 1.0 + 1.5;\n}\nfor (let i = 1; i <= numHouses; i++) {\n const consumption = baseConsumption + (Math.random() - 0.5) * 0.5;\n messages.push({\n    topic: `energo/consumo/energo_house_${i.toString().padStart(2, '0')}`,\n    payload: {\n        consumption_kw: parseFloat(consumption.toFixed(2)),\n        timestamp: now.toISOString(),\n        unit: \"kW\"\n    }\n });\n}\n\nreturn [messages];\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 100,
        "wires": [
            [
                "919cefbf9bad12a2",
                "54c04f17ce1e90ab",
                "a9c840a79c2e6220"
            ]
        ]
