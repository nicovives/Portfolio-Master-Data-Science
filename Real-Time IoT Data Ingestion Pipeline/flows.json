    {
        "id": "2ceeb5a73c867996",
        "type": "function",
        "z": "e8c2f47500521807",
        "name": "function 3",
        "func": "const anyo=2025, mes=8, diaInicio=1, diaFin=2;\nconst urls=[];\nfor (let d =diaInicio; d<=diaFin;d++) {\n    urls.push({\n    url:\"https://www.meteociel.fr/temps-reel/obs_villes.php?code2=8359&jour2=\"+\n    d+\"&mois2=\"+mes+\"&annee2=\"+anyo,\n    anyo,\n    mes,\n    dia: d\n    });\n    \n}\nconsole.log(urls);\nreturn [urls]; // AL meterlo dentro de corchetes se manda cada enlace por separado.\n",
